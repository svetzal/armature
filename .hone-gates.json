{
  "gates": [
    { "name": "deps", "command": "MIX_ENV=test mix deps.get", "required": true },
    { "name": "compile", "command": "MIX_ENV=test mix compile --warnings-as-errors", "required": true },
    { "name": "format", "command": "MIX_ENV=test mix format --check-formatted", "required": true, "fix_command": "MIX_ENV=test mix format" },
    { "name": "test", "command": "MIX_ENV=test mix test --cover", "required": true },
    { "name": "credo", "command": "MIX_ENV=test mix credo --strict", "required": true },
    { "name": "audit", "command": "MIX_ENV=test mix deps.audit", "required": true }
  ]
}
